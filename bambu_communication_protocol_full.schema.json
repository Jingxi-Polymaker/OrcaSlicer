      "type": "object",
      "required": ["pushing"],
      "properties": {
        "pushing": {
          "type": "object",
          "required": ["command", "sequence_id"],
          "properties": {
            "command": { "const": "pushall" },
            "sequence_id": { "type": "string" },
            "version": { "type": "integer" },
            "push_target": { "type": "integer" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "PushingStartStop": {
      "title": "pushing.start/stop",
      "type": "object",
      "required": ["pushing"],
      "properties": {
        "pushing": {
          "type": "object",
          "required": ["command", "sequence_id"],
          "properties": {
            "command": { "enum": ["start", "stop"] },
            "sequence_id": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
